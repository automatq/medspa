# Inline editor configuration. Set these in Vercel → Project → Environment
# Variables. Without them the public site is unaffected — /api/copy returns an
# empty map and every page falls back to the copy baked in at build time — but
# /admin will not work.

# ---------------------------------------------------------------- auth

# scrypt hash of the clinic's password, "<saltHex>:<keyHex>". Never the password
# itself. Generate one with:
#
#   node -e "import('./api/_lib/auth.mjs').then(m => m.hashPassword('the password').then(console.log))"
ADMIN_PASSWORD_HASH=

# Any long random string. Signs the session cookie; changing it signs everyone
# out. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------- storage

# Added automatically by the Vercel Marketplace → Upstash Redis integration.
# Holds the copy overrides and the login rate-limit counters.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Added automatically by Vercel Blob. Stores uploaded images.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------- bake

# Where `npm run bake` reads the live overrides from. Defaults to the production
# deployment, so this only needs setting when baking from somewhere else.
# COPY_API_URL=https://anima-medspa.vercel.app/api/copy
