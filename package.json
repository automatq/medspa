{
  "name": "anima-med-spa-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-services.mjs && node scripts/build-blog.mjs && node scripts/build-pages.mjs && node scripts/build-campaigns.mjs && node scripts/build-routes.mjs && node scripts/sync-root-pages.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "images": "node scripts/fetch-service-images.mjs",
    "images:blog": "node scripts/fetch-blog-images.mjs",
    "bake": "node scripts/bake-overrides.mjs",
    "bake:write": "node scripts/bake-overrides.mjs --write"
  },
  "dependencies": {
    "@vercel/blob": "^0.27.0"
  },
  "engines": {
    "node": "22.x"
  }
}
